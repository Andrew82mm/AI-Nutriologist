# Copy this file to .env and fill in the values for the ONE provider you use.
# .env is gitignored — never commit real API keys.

# Which LLM backend to use. Supported values: anthropic, openai_compatible
LLM_PROVIDER=

# Used by every provider.
LLM_API_KEY=

# Model name/ID as expected by the chosen provider.
LLM_MODEL=

# Only used when LLM_PROVIDER=openai_compatible. Base URL of the API endpoint.
# Leave empty to use OpenAI's own endpoint.
LLM_BASE_URL=


# ---------------------------------------------------------------------------
# Examples (uncomment the block for the provider you want, fill in the key):
# ---------------------------------------------------------------------------

# Anthropic (Claude) — native SDK, requires: pip install -e ".[llm-anthropic]"
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-4-8

# OpenAI — requires: pip install -e ".[llm-openai-compatible]"
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=

# Google Gemini, via Google's OpenAI-compatible endpoint — same package as above.
# Current GA line-up (July 2026): gemini-3.6-flash (best quality, cheaper than
# 3.5 Flash) and gemini-3.5-flash-lite (cheapest/fastest, weaker reasoning).
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=<Google AI Studio API key>
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Mistral — same package as above
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=...
# LLM_MODEL=mistral-large-latest
# LLM_BASE_URL=https://api.mistral.ai/v1

# Local model server (Ollama, vLLM, LM Studio, ...) — same package as above
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=not-needed-but-must-be-non-empty
# LLM_MODEL=llama3.1
# LLM_BASE_URL=http://localhost:11434/v1
